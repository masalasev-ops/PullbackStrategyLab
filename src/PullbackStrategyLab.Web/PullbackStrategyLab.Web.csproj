<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Web references Core alone. It reads through the Api over HTTP and never opens
    the store, so it has no reference to Data and no way to acquire a connection.
    see: The Web project reads through the Api and never opens the store
  -->

  <ItemGroup>
    <ProjectReference Include="..\PullbackStrategyLab.Core\PullbackStrategyLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The static files, copied beside the binary. The host sets its content root to where the
    binary sits, for the same reason the Worker's does, so the web root has to be there too or
    the stylesheet 404s and the pages render unstyled with nothing failing.
  -->
  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
