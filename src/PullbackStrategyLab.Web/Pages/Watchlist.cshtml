@page "/watchlist"
@using PullbackStrategyLab.Web.Shell
@model WatchlistModel
@*
    The morning screen: last night's published candidates, long and short in divided panels.

    Two panels and never one list with a direction column, on the rule the whole corpus is built
    around. A pooled figure on this screen would be the first one anybody read.

    Nothing here is stubbed. Where a column has no source yet the column is absent rather than
    blank, and the note under the panels says which checkpoint gives it one.
*@
<h1>@Model.Item.Title</h1>
<p class="lede">@Model.Item.What.</p>

@if (Model.Watchlist.DegradedBecause is string degraded)
{
    <p class="down">
        This night ran degraded: @degraded. Every candidate below was flagged on inputs that were
        already incomplete, which is a property of the night rather than of any one name.
    </p>
}

@*
    What the night did, before the candidates it produced. It is first because a list of nothing
    on a night that never ran and a list of nothing on a night that ran and kept nobody are the
    same picture, and only one of them is something to act on.

    It is the one panel in this interface whose subject is the running lab. Every check this
    corpus has takes its subject from the source, the documents, the golden fixture, or a store
    the check itself builds, and the lab is in none of those.
*@
@if (Model.Night.HasSlots)
{
    <section class="night @(Model.Night.NeedsAttention ? "ragged" : "clean")">
        <h2>The night of @Model.Night.AsOf</h2>
        <p class="count">@Model.Night.Count</p>

        @if (!Model.Night.NeedsAttention)
        {
            <p class="muted">Every slot the schedule owed this session ran and ended cleanly.</p>
        }

        @foreach (SlotView slot in Model.Night.Missing)
        {
            <p class="down">
                <b>@slot.At @slot.Slot never ran</b> (@slot.Runs).
                @if (slot.Unrecoverable is string lost)
                {
                    <span class="warns">@lost</span>
                }
                Rerun the slot for this date; the stages after it read what it should have written.
            </p>
        }

        @foreach (SlotView slot in Model.Night.Ragged)
        {
            <p class="warns">
                <b>@slot.At @slot.Slot</b>
                @string.Join("; ", slot.Stages.Select(s => s.Stage + ": " + s.Reads)).
            </p>
        }

        @if (Model.Night.Unobservable > 0)
        {
            @* Reported rather than dropped. A count of thirty-one under a heading saying
               thirty-two is the under-reporting shape, one level up from the store. *@
            @foreach (SlotView slot in Model.Night.Slots.Where(s => s.IsUnobservable))
            {
                <p class="muted"><b>@slot.At @slot.Slot</b>: @slot.Unobservable.</p>
            }
        }

        @if (Model.Night.Unscheduled.Count > 0)
        {
            <p class="muted">
                Also ran, belonging to no slot of this session:
                @string.Join(", ", Model.Night.Unscheduled). A stage run by hand is how a night gets
                repaired, so it is shown rather than dropped.
            </p>
        }
    </section>
}
else if (Model.Night.Absent is string noNight)
{
    <p class="muted">The night's slots could not be read: @noNight.</p>
}

@if (Model.Watchlist.Nothing is string nothing)
{
    @* "No candidates tonight" and "this page is not built" are different facts and the words have
       to be different too. Every unbuilt screen in this shell says "Nothing here yet", so a built
       page reusing that sentence would report itself as unbuilt on the one surface a person reads,
       and the test that asserts a landed screen has stopped waiting would pass on a page that
       claims it never arrived. *@
    <div class="empty-state">
        <p><b>No candidates published.</b> @nothing.</p>
        <p>The screen is built and this night has nothing on it. A night that published none is an
           ordinary outcome of the cap and the gates, and it is not the same as a page waiting for a
           checkpoint: those say so in the words above, and this one does not.</p>
    </div>
}
else
{
    <p class="lede">Session @Model.Watchlist.AsOf, @Model.Watchlist.Published published of the night's flagged setups.</p>

    <div class="row">
        @{
            void Panel(string title, string kind, IReadOnlyList<WatchlistRowView> rows)
            {
                <div class="col" style="flex:1">
                    <h2>@title <span class="pill">@rows.Count</span></h2>
                    @if (rows.Count == 0)
                    {
                        <p class="muted">The cap published nothing on this side tonight.</p>
                    }
                    else
                    {
                        <table class="watchlist @kind">
                            <tr>
                                <th>Rank</th><th>Ticker</th><th>Trigger</th><th>Give up</th>
                                <th>@WatchlistRowView.ScreenDistanceHeading (ADR)</th><th>Shares</th><th>Failed</th>
                            </tr>
                            @foreach (WatchlistRowView row in rows)
                            {
                                <tr class="@(row.Greyed ? "greyed" : null)">
                                    <td>@row.RankLabel</td>
                                    <td><a href="/chart/@row.Ticker">@row.Ticker</a></td>
                                    @* The plan's prices where a plan was written and the
                                       detector's where none was, from 4.18: the two differ, and
                                       the one a resting order is placed at is the plan's. *@
                                    <td>@row.Price(row.PublishedTrigger) @Html.Raw(row.PairMark)</td>
                                    <td>@row.Price(row.PublishedGiveUp) @Html.Raw(row.PairMark)</td>
                                    @* The screening geometry's distance, named for it in the heading:
                                       on a planned row the two prices beside it are the plan's. *@
                                    <td>@row.Price(row.StopDistanceRanges)</td>
                                    @* The size the plan committed to, from 4.11. Not the size that
                                       will be placed: RiskGate may reduce it at the trigger or
                                       block the order outright, hours after anybody reads this. A
                                       row the plan stage refused says so in words rather than
                                       showing a blank, which reads as a figure that came out
                                       empty. *@
                                    <td>@row.Shares</td>
                                    <td>
                                        @if (row.Failures.Count == 0)
                                        {
                                            <span class="pass">all pass</span>
                                        }
                                        else
                                        {
                                            @* The failing check, and which of its clauses fell over
                                               where it has more than one. A row greyed for
                                               tradable-shortable said nothing about which of four
                                               floors it missed until 4.1. *@
                                            @string.Join(", ", row.Failures.Select(f => f.Label))
                                        }
                                    </td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            }
        }
        @{ Panel("Long", "long", Model.Watchlist.Long); }
        @{ Panel("Short", "short", Model.Watchlist.Short); }
    </div>

    <p class="muted">
        <b>The share count is the plan's intention, and there is no conflict banner yet.</b> The
        column shows what PlanBuilder committed to at 18:30, and RiskGate may reduce it at the
        trigger or block the order outright, so what was placed is the trade journal's figure and
        not this one. A row the plan stage refused says so in words rather than showing a blank. The
        conflict banner needs an open position to conflict with and arrives at
        <b>@WatchlistView.ConflictArrivesAt</b>; it is absent rather than drawn empty, because a
        column with no source reads as a figure the lab computed and got nothing for.
    </p>
}
